CLASSPILOT_PORT=3020
NEXT_PUBLIC_APP_URL=http://localhost:3020
CLASSPILOT_DATABASE_PATH=/app/data/classpilot.sqlite
CLASSPILOT_APP_PASSWORD=change-this-before-real-data
CLASSPILOT_AUTH_SECRET=replace-with-a-long-random-secret
CLASSPILOT_COOKIE_SECURE=false

# Encrypts sensitive Student CMS fields at rest (32 bytes, base64).
# Generate with: openssl rand -base64 32
# Required in production. Store it in a password manager and NEVER in a backup
# alongside the database -- if it is lost, encrypted fields are unrecoverable.
CLASSPILOT_DATA_KEY=replace-with-openssl-rand-base64-32

# AI planning assistant (optional). Disabled until either the hosted or
# local path below is set (or both -- see docs/CONFIG-REFERENCE.md for how
# they're used differently). Only curriculum and timing context is ever
# sent to a provider -- student records are never transmitted, regardless
# of provider. Settings saved via /settings/ai in the running app take
# priority over these env vars.
#
# Hosted provider (e.g. OpenAI) -- drafts content only (unit outlines,
# lesson sections, lesson resources), never given student data:
#   CLASSPILOT_AI_API_KEY=sk-...
#   CLASSPILOT_AI_BASE_URL=https://api.openai.com/v1
#   CLASSPILOT_AI_MODEL=gpt-4o-mini   (default if unset)
CLASSPILOT_AI_API_KEY=
CLASSPILOT_AI_BASE_URL=
CLASSPILOT_AI_MODEL=
#
# Local, OpenAI-compatible server (Ollama, LM Studio, ...) -- no key
# required. Drives the assistant chat's tool-calling and is the ONLY
# provider ever given access to student data (roster, notes), since it
# stays on your network:
#   CLASSPILOT_AI_LOCAL_BASE_URL=http://localhost:11434/v1
#   CLASSPILOT_AI_LOCAL_MODEL=llama3.1
CLASSPILOT_AI_LOCAL_BASE_URL=
CLASSPILOT_AI_LOCAL_MODEL=

# Voice dictation (issue #36) -- an OpenAI-Whisper-API-compatible local
# transcription service (faster-whisper, whisper.cpp server mode, etc.).
# Same reasoning as the local AI provider above: recordings contain real
# student names/details, so this must stay on your network. No hosted
# fallback exists or ever will.
#   CLASSPILOT_TRANSCRIPTION_URL=http://localhost:9000
#   CLASSPILOT_TRANSCRIPTION_MODEL=whisper-1   (default if unset)
CLASSPILOT_TRANSCRIPTION_URL=
CLASSPILOT_TRANSCRIPTION_MODEL=

# MCP server (mcp-server/, runs as the classpilot-mcp container). Lets an
# MCP client (Claude Code, Claude Desktop) read and write units/lessons over
# Streamable HTTP. Auth is per-user tokens created from Settings > MCP
# Tokens in the running app -- there is nothing to set here. See
# docs/MCP-SETUP.md.
CLASSPILOT_MCP_PORT=3900

# ICS calendar subscription feed (/calendar/feed.ics). Travels in the URL's
# query string (?token=...), not a header, since calendar apps subscribing
# by URL can't send custom headers or hold a session cookie -- use a
# URL-safe token (hex, not base64: base64's +/= chars cause problems in
# query strings). Generate with: openssl rand -hex 32
CLASSPILOT_CALENDAR_TOKEN=replace-with-openssl-rand-hex-32

# Where uploaded lesson/unit attachment files are stored (optional --
# defaults to data/attachments, alongside the SQLite database under the
# same ./data bind mount, so it's covered by the same backup already).
# CLASSPILOT_ATTACHMENTS_DIR=/app/data/attachments
