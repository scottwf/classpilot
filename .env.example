CLASSPILOT_PORT=3020
NEXT_PUBLIC_APP_URL=http://localhost:3020
CLASSPILOT_DATABASE_PATH=/app/data/classpilot.sqlite
CLASSPILOT_APP_PASSWORD=change-this-before-real-data
CLASSPILOT_AUTH_SECRET=replace-with-a-long-random-secret
CLASSPILOT_COOKIE_SECURE=false

# Encrypts sensitive Student CMS fields at rest (32 bytes, base64).
# Generate with: openssl rand -base64 32
# Required in production. Store it in a password manager and NEVER in a backup
# alongside the database -- if it is lost, encrypted fields are unrecoverable.
CLASSPILOT_DATA_KEY=replace-with-openssl-rand-base64-32

# AI planning assistant (optional). The assistant is disabled until one of the
# enable paths below is set. Only curriculum and timing context is ever sent to
# the provider -- student records are never transmitted.
#
# Hosted provider (e.g. OpenAI):
#   CLASSPILOT_AI_API_KEY=sk-...
# Local, OpenAI-compatible server for full-privacy homelab use (Ollama,
# LM Studio, ...) -- no key required:
#   CLASSPILOT_AI_BASE_URL=http://localhost:11434/v1
# Optional model override (defaults to gpt-4o-mini):
#   CLASSPILOT_AI_MODEL=gpt-4o-mini
CLASSPILOT_AI_API_KEY=
CLASSPILOT_AI_BASE_URL=
CLASSPILOT_AI_MODEL=

# MCP server (mcp-server/, runs as the classpilot-mcp container). Lets an
# MCP client (Claude Code, Claude Desktop) read and write units/lessons over
# Streamable HTTP. Required header on every request: x-classpilot-mcp-key.
# Generate with: openssl rand -base64 32
CLASSPILOT_MCP_TOKEN=replace-with-openssl-rand-base64-32
CLASSPILOT_MCP_PORT=3900

# ICS calendar subscription feed (/calendar/feed.ics). Travels in the URL's
# query string (?token=...), not a header, since calendar apps subscribing
# by URL can't send custom headers or hold a session cookie -- use a
# URL-safe token (hex, not base64: base64's +/= chars cause problems in
# query strings). Generate with: openssl rand -hex 32
CLASSPILOT_CALENDAR_TOKEN=replace-with-openssl-rand-hex-32
